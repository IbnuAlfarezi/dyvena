# Copy this file to .env.local and fill in the values.
# .env.local is excluded from Git (.gitignore).

DATABASE_URL=postgres://app:app@localhost:5433/app_db

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# In production, set this to your actual domain, e.g. https://dyvena.ibnualfarezi.my.id
BETTER_AUTH_URL=http://localhost:3000
